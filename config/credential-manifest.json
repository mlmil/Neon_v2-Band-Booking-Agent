{
  "version": 1,
  "policy": "credential_parity",
  "agents": ["codex", "claude", "gemini", "hermes"],
  "shared_environment_file": ".secrets/neon-v2.env",
  "credentials": [
    {
      "id": "gmail",
      "purpose": "Read-only Neon Blonde Gmail intake and approval-gated SMTP",
      "required": true,
      "sources": [
        {"type": "env_path", "name": "NEON_SMTP_CONFIG", "kind": "file"},
        {"type": "file", "path": ".secrets/smtp_config.json"}
      ]
    },
    {
      "id": "wordpress",
      "purpose": "Public show-card updates",
      "required": true,
      "sources": [
        {"type": "env", "name": "NEON_WP_USERNAME"},
        {"type": "env", "name": "NEON_WP_APP_PASSWORD"}
      ]
    },
    {
      "id": "local_drive",
      "purpose": "Locally mirrored Neon Blonde Google Drive files",
      "required": true,
      "sources": [
        {"type": "env_path", "name": "NEON_DRIVE_ROOT", "kind": "dir"}
      ]
    }
  ]
}
